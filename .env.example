# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais committer le .env.

# Clé de l'API WeLoveDevs (fournie dans le cadre du partenariat Epitech).
# Sans clé, l'application démarre mais ne collecte aucune offre : voir demo/ dans le README.
WELOVEDEVS_API_KEY=

# Base MySQL (utilisée par les services db et backend)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jobaggregator
MYSQL_USER=jobaggregator
MYSQL_PASSWORD=change-me
